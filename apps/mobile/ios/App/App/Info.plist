<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- &#8194; is an EN SPACE, not a typo. SpringBoard tightens home-screen
	     icon labels past ~10 characters and an ASCII space is the first thing
	     it swallows, rendering this as "CMUO-Quest". An en space is twice as
	     wide, so a gap survives the squeeze. The value is still exactly
	     "CMU O-Quest" to anything that reads it. -->
	<key>CFBundleDisplayName</key>
	<string>CMU&#8194;O-Quest</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.scottylabs.quest</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>org.scottylabs.quest</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NFCReaderUsageDescription</key>
	<string>Orientation Quest reads challenge tags around campus to mark them complete.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Orientation Quest records where a challenge tag was tapped to confirm you were there.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Orientation Quest records where a challenge tag was tapped to confirm you were there. It only checks your location while you are using the app.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to commemorate a challenge you just cleared.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>The commemoration camera is a system photo component that can also browse your library, so O-Quest asks for access. It only reads a photo you pick yourself and never scans your library.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Only used when you save a commemoration photo out to your library. Photos you take are otherwise kept inside O-Quest.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>Splash</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
