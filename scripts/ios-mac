set -euo pipefail

cd "$(cd "$(dirname "$0")/.." && pwd)"

for dir in /opt/homebrew/bin /usr/local/bin "$HOME/.deno/bin" /opt/local/bin; do
  [ -d "$dir" ] && PATH="$dir:$PATH"
done
export PATH

command -v deno >/dev/null || {
  echo "deno not found. PATH=$PATH" >&2
  echo "install with: brew install deno" >&2
  exit 1
}

xcodebuild -version >/dev/null 2>&1 || {
  echo "xcodebuild unavailable. Active developer dir: $(xcode-select -p 2>&1)" >&2
  echo "Install full Xcode, then point at it:" >&2
  echo "  sudo xcode-select -s /Applications/Xcode.app/Contents/Developer" >&2
  echo "  sudo xcodebuild -license accept" >&2
  echo "If Xcode lives on an external volume, check the mount name first: an" >&2
  echo "exFAT/FSKit disk can reappear as /Volumes/My-Disk instead of 'My Disk'," >&2
  echo "which leaves xcode-select pointing at a path that no longer exists." >&2
  exit 1
}

keychain="$HOME/Library/Keychains/login.keychain-db"
pass_file="$HOME/.quest-keychain-pass"

if [ -z "${QUEST_KEYCHAIN_PASSWORD:-}" ] && [ -r "$pass_file" ]; then
  QUEST_KEYCHAIN_PASSWORD=$(cat "$pass_file")
fi
if [ -n "${QUEST_KEYCHAIN_PASSWORD:-}" ]; then
  security unlock-keychain -p "$QUEST_KEYCHAIN_PASSWORD" "$keychain"
fi

if [ -z "${QUEST_SKIP_KEYCHAIN:-}" ]; then
  probe_id=$(security find-identity -v -p codesigning 2>/dev/null | awk '/^ *1\)/{print $2; exit}')
  probe_dir=$(mktemp -d)
  cp /usr/bin/true "$probe_dir/probe"
  probe_ok=0
  [ -n "$probe_id" ] && codesign -f -s "$probe_id" "$probe_dir/probe" >/dev/null 2>&1 && probe_ok=1
  rm -rf "$probe_dir"

  if [ "$probe_ok" -ne 1 ]; then
    echo "codesign cannot sign in this ssh session (errSecInternalComponent)." >&2
    echo "The GUI login does not unlock the keychain for ssh; it needs the password." >&2
    echo >&2
    echo "Store it once on the Mac - paste as ONE line, nothing lands in history:" >&2
    echo >&2
    echo "  (umask 077; printf 'login password: '; read -rs p; echo; printf '%s' \"\$p\" > $pass_file)" >&2
    echo >&2
    echo "Then re-run. Alternatively export QUEST_KEYCHAIN_PASSWORD for one build," >&2
    echo "or QUEST_SKIP_KEYCHAIN=1 to bypass this check entirely." >&2
    exit 1
  fi
fi

# The catalog carries the app icon and the launch image (Info.plist's
# UILaunchScreen names "Splash"), so it is built by default.
#
# But actool does not compile an iOS catalog itself: it forks ibtoold, which
# asks CoreSimulator for a device type, which synchronously XPCs simdiskimaged.
# When that daemon is wedged the reply never comes and the build hangs forever
# with no output - not a slow build, a deadlock. So probe it first, and treat a
# wedge as a build failure: an IPA without the app icon is not shippable.
# --app-icon and --output-partial-info-plist are load-bearing here, NOT
# decoration: without the partial plist actool skips app-icon compilation
# entirely (it says so in a notice), returns 0 in ~2s, and never touches
# CoreSimulator - a probe that always passes while the real build deadlocks.
actool_answers() {
  local out plist pid kids watchdog rc=0
  out=$(mktemp -d)
  plist=$(mktemp)
  actool_log=$(mktemp)
  "$(xcode-select -p)/usr/bin/actool" apps/mobile/ios/App/App/Assets.xcassets \
    --compile "$out" --output-partial-info-plist "$plist" --app-icon AppIcon \
    --output-format human-readable-text \
    --platform iphoneos --minimum-deployment-target 16.0 \
    --target-device iphone --development-region en \
    >"$actool_log" 2>&1 &
  pid=$!
  (
    sleep "${QUEST_ACTOOL_PROBE_TIMEOUT:-45}"
    kids=$(pgrep -P "$pid" 2>/dev/null || true)
    kill -9 "$pid" $kids 2>/dev/null || true
  ) &
  watchdog=$!
  wait "$pid" 2>/dev/null || rc=$?
  # `wait` returns the instant actool dies, so anything after the kill inside
  # the watchdog loses a race against this SIGTERM - reap here instead. The
  # extra `wait` swallows bash's "Terminated" job notice.
  { kill "$watchdog" && wait "$watchdog"; } 2>/dev/null || true
  if [ "$rc" -ne 0 ]; then
    # ibtoold becomes its own session leader at once, so it is already
    # reparented to launchd and `pgrep -P` cannot see it. Sweep by name: it is
    # an on-demand helper Xcode respawns, so a stray kill costs nothing.
    pkill -9 -x -u "$(id -u)" ibtoold 2>/dev/null || true
  fi
  rm -rf "$out" "$plist"
  return "$rc"
}

asset_args=()
skip_why=""
if [ -n "${QUEST_SKIP_ASSETS:-}" ]; then
  skip_why="QUEST_SKIP_ASSETS is set"
  asset_args=(EXCLUDED_SOURCE_FILE_NAMES="Assets.xcassets" ASSETCATALOG_COMPILER_APPICON_NAME="")
else
  echo "==> probing actool (waits up to ${QUEST_ACTOOL_PROBE_TIMEOUT:-45}s; a wedge is silent)"
  actool_answers || {
    rc=$?
    echo >&2
    if [ "$rc" -gt 128 ]; then
      cat >&2 <<'WEDGED'
actool never answered - it deadlocked, so no app icon and no launch image.

This is not the assets. actool forks ibtoold, which asks CoreSimulator for a
device type over a synchronous XPC with no timeout. If simdiskimaged is not
answering, that call blocks forever:
  launchctl print system/com.apple.CoreSimulator.simdiskimaged | grep -E 'state|runs|last exit'

A climbing "runs" plus "JETSAM_REASON_MEMORY_PERPROCESSLIMIT" means the daemon
is crash-looping: CoreSimulatorService submits it with a 15 MB inactive memory
cap that its own idle footprint already reaches, so the kernel kills it ~2s in,
forever. Give it a real launchd job without that cap (already installed on this
Mac at /Library/LaunchDaemons/com.apple.CoreSimulator.simdiskimaged.plist -
recreate it if it goes missing, then `sudo launchctl bootstrap system <plist>`).
WEDGED
    else
      echo "actool failed (exit $rc), so no app icon and no launch image:" >&2
      grep -E 'error:' "$actool_log" >&2 || tail -5 "$actool_log" >&2
      cat >&2 <<'MISMATCH'

"No simulator runtime version ... available to use with iphonesimulator SDK"
means the installed runtime is NEWER than Xcode's SDK, which Apple forbids.
Let Xcode fetch the one it wants (~8 GB, needs the disk space):
  sudo DEVELOPER_DIR="$(xcode-select -p)" xcodebuild -downloadPlatform iOS
MISMATCH
    fi
    echo >&2
    echo "QUEST_SKIP_ASSETS=1 builds without an icon, if you need an IPA anyway." >&2
    rm -f "$actool_log"
    exit 1
  }
  rm -f "$actool_log"
fi

echo "==> resolving deps"
deno install --quiet

: "${VITE_QUEST_API_BASE:?not set - run via scripts/ios-remote, which bakes it in}"
echo "==> building web assets (backend: $VITE_QUEST_API_BASE)"
VITE_QUEST_API_BASE="$VITE_QUEST_API_BASE" deno task --cwd apps/mobile build

echo "==> cap sync ios${CAP_SERVER_URL:+ (dev server: $CAP_SERVER_URL)}"
CAP_SERVER_URL="${CAP_SERVER_URL:-}" deno task --cwd apps/mobile cap sync ios

cd apps/mobile/ios/App

# Guard every expansion of asset_args: ssh runs this under macOS /bin/sh (bash
# 3.2), where `set -u` rejects an empty array as unbound.
echo "==> xcodebuild${skip_why:+ (no asset catalog)}"
[ -z "$skip_why" ] || echo "    no app icon, no launch image: $skip_why"

config=Debug
[ -z "${QUEST_RELEASE:-}" ] || config=Release
echo "    configuration $config"

if [ -z "${QUEST_RELEASE:-}" ]; then
  xcodebuild \
    -project App.xcodeproj \
    -scheme App \
    -configuration "$config" \
    -destination generic/platform=iOS \
    -derivedDataPath DerivedData \
    -allowProvisioningUpdates \
    ENABLE_DEBUG_DYLIB=NO \
    ENABLE_PREVIEWS=NO \
    COMPRESS_PNG_FILES=NO \
    ASSETCATALOG_COMPILER_OPTIMIZATION=time \
    ${asset_args[@]+"${asset_args[@]}"} \
    build

  app=$(find DerivedData/Build/Products -maxdepth 2 -name 'App.app' -print -quit)
  [ -n "$app" ] || { echo "no App.app under DerivedData" >&2; exit 1; }

  echo "==> signed entitlements"
  codesign -d --entitlements :- "$app" 2>/dev/null | grep -A2 'nfc\|application-identifier' || {
    echo "  WARNING: no nfc/application-identifier entitlement in the signature" >&2
  }

  echo "==> packaging ipa"
  rm -rf dist
  mkdir -p dist/Payload
  cp -R "$app" dist/Payload/
  (cd dist && zip -qry App.ipa Payload && rm -rf Payload)

  echo "==> $(pwd)/dist/App.ipa"
  exit 0
fi

team=$(sed -n 's/.*DEVELOPMENT_TEAM = \([A-Z0-9]*\);.*/\1/p' App.xcodeproj/project.pbxproj | head -1)
[ -n "$team" ] || { echo "no DEVELOPMENT_TEAM in project.pbxproj" >&2; exit 1; }
echo "    team $team"

rm -rf dist
mkdir -p dist

xcodebuild \
  -project App.xcodeproj \
  -scheme App \
  -configuration Release \
  -destination generic/platform=iOS \
  -derivedDataPath DerivedData \
  -archivePath dist/App.xcarchive \
  -allowProvisioningUpdates \
  ENABLE_PREVIEWS=NO \
  COMPRESS_PNG_FILES=NO \
  ASSETCATALOG_COMPILER_OPTIMIZATION=time \
  ${asset_args[@]+"${asset_args[@]}"} \
  archive

cat > dist/export.plist <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>${QUEST_EXPORT_METHOD:-app-store-connect}</string>
	<key>teamID</key>
	<string>$team</string>
	<key>uploadSymbols</key>
	<true/>
	<key>signingStyle</key>
	<string>automatic</string>
</dict>
</plist>
PLIST

echo "==> exporting for ${QUEST_EXPORT_METHOD:-app-store-connect}"
xcodebuild -exportArchive \
  -archivePath dist/App.xcarchive \
  -exportPath dist \
  -exportOptionsPlist dist/export.plist \
  -allowProvisioningUpdates

ipa=$(find dist -maxdepth 1 -name '*.ipa' -print -quit)
[ -n "$ipa" ] || { echo "export produced no ipa" >&2; exit 1; }

echo "==> signed entitlements"
codesign -d --entitlements :- "dist/App.xcarchive/Products/Applications/App.app" 2>/dev/null |
  grep -A2 'nfc\|application-identifier' || true

echo "==> $(pwd)/$ipa"
echo "    upload: xcrun altool --upload-app -f $ipa -t ios --apiKey KEYID --apiIssuer ISSUER"
